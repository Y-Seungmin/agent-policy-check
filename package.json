{
  "name": "agent-policy-check",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Deterministically enforce repository-defined pull request policies",
  "repository": {
    "type": "git",
    "url": "https://github.com/Y-Seungmin/agent-policy-check.git"
  },
  "scripts": {
    "test": "node --import tsx --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-exclude=src/index.ts --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 --test tests/**/*.test.ts",
    "test:e2e": "node --import tsx --test e2e/**/*.test.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --minify --platform=node --format=cjs --outfile=dist/index.js",
    "verify": "pnpm test && pnpm run build && pnpm run test:e2e && pnpm audit --prod"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
